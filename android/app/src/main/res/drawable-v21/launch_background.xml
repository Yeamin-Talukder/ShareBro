<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the app icon on its cream tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item android:width="160dp" android:height="160dp" android:gravity="center">
        <shape android:shape="oval"><solid android:color="#F6F3F1" /></shape>
    </item>
    <item android:width="240dp" android:height="240dp" android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
